# Headless mode only (the Pi). The Mac app keeps its settings in
# ~/Library/Application Support/Strip Bay and is configured in the Setup panel.
#
# Copy to config.env and edit. Values shown are the defaults.

# Host running dump1090-fa / dump978-fa. Leave as-is if Strip Bay runs on the Pi.
PIAWARE_HOST=127.0.0.1

# Only set these if auto-detection picks the wrong path. Use "off" to disable a band.
#FEED_1090_URL=http://127.0.0.1/skyaware/data/aircraft.json
#FEED_978_URL=off

# Only needed if receiver.json has no position set.
#RECEIVER_LAT=00.0000
#RECEIVER_LON=00.0000

BIND=0.0.0.0
PORT=8890
POLL_INTERVAL=1.0

# Seconds to keep a strip in the bay after the last message.
CONTACT_TTL=60

#REGISTRY_DB=/home/pi/strip-bay/registry.db
